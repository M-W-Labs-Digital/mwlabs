{
  "name": "mwlabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:check": "npm run security:secrets && npm audit --audit-level=high",
    "jobs:smoke": "node --env-file=.env scripts/test-background-jobs.mjs",
    "scale:smoke": "node --env-file=.env scripts/test-scale.mjs",
    "notifications:smoke": "node --env-file=.env scripts/test-notifications.mjs",
    "workflow:smoke": "node --env-file=.env scripts/test-agency-workflow.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test tests/*.test.mjs",
    "production:check": "node scripts/check-production.mjs",
    "security:runtime": "npm run security:secrets && npm audit --omit=dev --audit-level=high",
    "check": "npm test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/prisma-adapter": "^1.6.26",
    "@google/genai": "^2.16.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "shadcn": "^4.16.1"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.0"
  }
}
